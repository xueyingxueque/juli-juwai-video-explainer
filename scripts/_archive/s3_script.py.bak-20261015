        'rule': '每句至少留一个"想知道"，句间有悬念',
        'opening': '经典开头：注意看…／你敢信吗？／太气人了！',
        'tempo': '快', 'check': ['每句是否留了想知道', '句间是否有悬念', '是否有经典开头套路'],
    },
    '毒舌流': {
        'skill': '短剧解说毒舌流灵魂',
