        'tempo': '快', 'check': ['每3句有吐槽点吗', '梗密吗', '态度明确吗'],
    },
    '感动流': {
        'skill': '短剧解说感动流灵魂',
        'persona': '用「我」直接说话，温柔细腻腔',
